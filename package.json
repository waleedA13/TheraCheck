{
  "name": "theracheck",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "db:reset": "tsx --env-file=.env.local src/backend/db/reset.ts",
    "db:migrate": "tsx src/backend/db/migrate.ts .env.local",
    "verify": "tsx --env-file=.env.local src/backend/verifier/verify.ts",
    "test:e2e": "playwright test",
    "test:int": "npm run db:test:reset && vitest run --project int",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait --wait-timeout 60",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "db:test:reset": "tsx --env-file=.env.test src/backend/db/reset.ts --local-only"
  },
  "dependencies": {
    "@elevenlabs/react": "^1.23.1",
    "@google/genai": "^3.6.1",
    "@neon/config": "^1.14.4",
    "@neon/env": "^2.1.7",
    "@neondatabase/serverless": "^1.2.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
